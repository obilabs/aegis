{
  "name": "@obilabs/aegis",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Aegis Client - Self-hosted ITSM portal (Open Source)",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:network": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npx @better-auth/cli generate",
    "db:migrate": "npx @better-auth/cli migrate",
    "seed:admin": "npx tsx scripts/seed-admin.ts",
    "seed:data": "Get-Content database/seed.sql | docker exec -i aegis_postgres psql -U postgres -d aegis",
    "check:secrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.999.0",
    "@better-auth/passkey": "~1.4.18",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@obilabs/api-scopes": "^0.1.1",
    "@obilabs/documents": "^0.1.1",
    "@obilabs/email": "^0.1.0",
    "@obilabs/licensing": "^0.1.2",
    "@scalar/nextjs-api-reference": "^0.9.19",
    "bcryptjs": "^2.4.3",
    "better-auth": "~1.4.18",
    "imapflow": "~1.3.2",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.8",
    "next": "^15.5.12",
    "nodemailer": "^8.0.6",
    "pg": "^8.13.0",
    "pg-boss": "^12.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@better-auth/cli": "~1.4.18",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.19.0"
}
