    "@better-auth/passkey": "~1.7.4",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@obilabs/api-scopes": "^0.2.0",
    "@obilabs/documents": "^0.2.0",
    "@obilabs/email": "^0.2.0",
    "@obilabs/licensing": "^0.2.0",
    "@scalar/nextjs-api-reference": "^0.11.18",
    "bcryptjs": "^2.4.3",
    "better-auth": "~1.6.22",
    "imapflow": "~1.7.8",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.26",
    "next": "^15.5.25",
    "nodemailer": "^9.1.1",
    "pg": "^8.13.0",
    "pg-boss": "^12.31.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.6"
