      "nodemailer": "^9.1.1",
      "sharp": "^0.35.4",
      "fast-uri": "^3.1.6",
      "sanitize-html": "^2.17.7",
      "qs": "^6.16.0",
      "hono": "^4.13.5",
      "postcss": "^8.5.28",
      "deepmerge-ts": "^8.0.2",
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    }
  }
