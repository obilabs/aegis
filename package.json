  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Aegis - self-hosted IT service management (open source)",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:network": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npx @better-auth/cli@latest generate",
    "db:migrate": "npx @better-auth/cli@latest migrate",
    "seed:admin": "npx tsx scripts/seed-admin.ts",
    "check:secrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1131.0",
