# =============================================================================
# Aegis Client - Environment Configuration
# =============================================================================
# Copy this file to .env and update values before first run.
#
# Required changes for production:
#   1. Set BETTER_AUTH_SECRET (openssl rand -base64 32)
#   2. Set POSTGRES_PASSWORD (openssl rand -hex 16)
#   3. Set ADMIN_EMAIL and ADMIN_PASSWORD
#   4. Set BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL to your domain

# -----------------------------------------------------------------------------
# Telemetry & Privacy
# -----------------------------------------------------------------------------
# Master kill-switch for outbound telemetry. When set to "false", NO
# telemetry is sent — not the Tier 0 install ping, not the license
# re-validation, not the usage heartbeat. The license continues to
# function locally; it just isn't re-checked with the control plane
# until this var is removed and the container restarted.
#
# The env var BEATS any in-app setting (admin can't override an
# operator who deployed the container with this off). In-app control
# at /portal/settings (admin-only) when the var is unset.
#
# See README.md "Telemetry & Privacy" and PRINCIPLES.md #2 for details.
# TELEMETRY_ENABLED=false
#
# Phone-home endpoint overrides. Leave unset to reach the obilabs control
# plane at https://api.obilabs.dev. Self-hosters running their OWN control
# plane override these to redirect all phone-home traffic there — no compose
# edit needed (they are ${VAR:-} passthroughs in docker-compose.yml).
#   TELEMETRY_URL  usage / heartbeat POST target
#                  (default https://api.obilabs.dev/api/instances/heartbeat)
#   LICENSE_URL    license re-validation URL; the control-plane base is
#                  derived from it by stripping /api/instances/validate.
#   LICENSE_HEARTBEAT_INTERVAL_MS  re-validation cadence in ms
#                  (default 1200000 = 20 min; floored at 300000 = 5 min)
# TELEMETRY_URL=https://cp.example.com/api/instances/heartbeat
# LICENSE_URL=https://cp.example.com/api/instances/validate
# LICENSE_HEARTBEAT_INTERVAL_MS=1200000

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Host port for web access (nginx maps this to port 80 internally)
PORT=8080

# Interface nginx binds to on the host. Defaults to 0.0.0.0 (all
# interfaces) which is right for standalone hosts. Set to a specific
# IP like 172.25.10.20 when running on a shared LAN host to avoid
# port conflicts with sibling stacks (aegis-web, aegis-mtp, etc.).
# BIND_HOST=0.0.0.0

# Image version to pull from ghcr.io (built by GitHub Actions)
# Use 'latest' for bleeding edge, or pin to a version like '0.1.0'
AEGIS_VERSION=latest

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# OPTIONAL. Leave BLANK/omitted to have a strong secret auto-generated and
# persisted to ${AEGIS_SECRETS_DIR}/BETTER_AUTH_SECRET.key on first boot
# (spec: zero-config-secret-bootstrap). Set it explicitly to pin/rotate or to
# inject via a secret manager (env always wins). Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL of your Aegis instance (must match how users access it)
BETTER_AUTH_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Encryption keys (two SEPARATE keys — do not reuse one for both)
# -----------------------------------------------------------------------------
# Both are OPTIONAL: omit them and they are auto-generated + persisted to
# ${AEGIS_SECRETS_DIR} on first boot. IMPORTANT: that directory (./data/secrets)
# then holds your master keys — BACK IT UP with the rest of ./data. Losing
# CREDENTIAL_ENCRYPTION_KEY orphans stored credentials. Set them explicitly to
# pin/rotate or inject externally (env always wins).
#
# Where auto-generated keys are persisted (bind-mounted; default shown):
AEGIS_SECRETS_DIR=/app/data/secrets
#
# AES-256-GCM key for EMAIL provider-config envelope encryption + Message-ID
# HMAC signing. Generate: openssl rand -hex 32  (-> 64 hex chars)
AEGIS_SECRETS_KEY=

# AES-256-GCM key for the CREDENTIAL VAULT (lib/encryption.ts), DISTINCT from
# AEGIS_SECRETS_KEY. Generate: openssl rand -hex 32  (exactly 64 hex chars).
CREDENTIAL_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Vendor outbound links (portal footer)
# -----------------------------------------------------------------------------
# Where the portal's "Support the project" and "Get help" links point.
# Default: the canonical ObiLabs web surface. Standard OSS pattern —
# Plausible, Mattermost, Penpot all link self-hosted installs at their
# vendor site for sponsorship, support, and docs.
#
# Set to empty string to hide the footer entirely (air-gapped opt-out).
# Set to your own URL if you're white-labelling / forking Aegis.
NEXT_PUBLIC_VENDOR_URL=https://api.obilabs.dev

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Password for the PostgreSQL database (used by both postgres and app containers)
POSTGRES_PASSWORD=aegis

# -----------------------------------------------------------------------------
# Admin Account — two deploy modes
# -----------------------------------------------------------------------------
# Mode 1 (RECOMMENDED for individual operators): leave ADMIN_PASSWORD blank.
#   On first visit, browse to /portal/setup, pick your email + password
#   in the browser, then walk through the org wizard (which includes the
#   non-bypassable telemetry consent step — see PRINCIPLES.md #2).
#   No admin secrets ever live in this file.
#
# Mode 2 (headless / CI/CD): set ADMIN_PASSWORD below. Aegis seeds the
#   admin account from these values on first boot. Sign-in works
#   immediately. The first browser visit lands directly in the org
#   wizard (the telemetry consent step still fires — that's by design).
#
# In either mode, the telemetry consent flow surfaces during the wizard.
# An operator who pre-seeds the admin is implicitly committing to walk
# their first browser user through that step.
ADMIN_EMAIL=admin@aegis.local
ADMIN_PASSWORD=
ADMIN_NAME=Aegis Administrator

# Set to 'true' to allow public user registration (disabled by default)
ALLOW_REGISTRATION=false

# -----------------------------------------------------------------------------
# Support Contact (shown on login page)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPPORT_EMAIL=helpdesk@company.com
# NEXT_PUBLIC_SUPPORT_TEAM=IT Helpdesk

# -----------------------------------------------------------------------------
# AI Assistant (optional)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Document Processing (optional — requires Docling sidecar)
# -----------------------------------------------------------------------------
# Uncomment the docling service in docker-compose.yml to enable PDF/DOCX import.
# DOCLING_URL=http://docling:5001

# -----------------------------------------------------------------------------
# Email Notifications (optional)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_FROM=noreply@aegis.local

# -----------------------------------------------------------------------------
# Object Storage (optional, for file attachments)
# -----------------------------------------------------------------------------
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin123
# S3_BUCKET=aegis-uploads
# S3_REGION=us-east-1
